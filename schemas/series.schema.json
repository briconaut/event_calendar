{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ortsunabhängige Eventserien (Wanderevents mit wechselndem Austragungsort)",
  "type": "object",
  "required": ["series"],
  "additionalProperties": false,
  "$defs": {
    "url": {"type": "string", "pattern": "^https?://"}
  },
  "properties": {
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "calendar", "scope"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "calendar": {"enum": ["weihnachtsmaerkte", "feuerwerke", "events"]},
          "scope": {"type": "string", "minLength": 1, "description": "Gebiet, in dem der Austragungsort wechselt, z. B. Hessen, Deutschland"},
          "category": {"type": "string"},
          "major": {"type": "boolean"},
          "homepage": {"$ref": "#/$defs/url"},
          "sources": {"type": "array", "items": {"$ref": "#/$defs/url"}},
          "typical_period": {"type": "string"},
          "has_fireworks": {"type": "boolean"},
          "notes": {"type": "string", "description": "Freitext, z. B. bekannte künftige Austragungsorte"}
        }
      }
    }
  }
}
